{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "smtc-widget",
  "version": "0.1.0",
  "identifier": "com.iseen.smtc-widget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "smtc-widget",
        "decorations": false,
        "resizable": false,
        "transparent": true,
        "shadow": false,
        "width": 250,
        "height": 40,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focusable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data:",
        "style-src": "'self'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
